# agentmail-server config — copy to agentmail.toml and edit.
#
# This file holds ONLY runtime settings (where to listen, where the database
# is). First-time initialization (mail domain, admin password) is done through
# the setup wizard in the web panel and persisted in the database — NOT here.

[server]
# HTTP listen address. Use 127.0.0.1 for local-only; 0.0.0.0 to allow remote
# (put a reverse proxy with TLS in front for remote access).
listen = "127.0.0.1:8090"

[storage]
# Path to the bbolt database file. Holds accounts, messages, audit log,
# and system metadata (domain, initialized flag).
db_path = "agentmail.db"
